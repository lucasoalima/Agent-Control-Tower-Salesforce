# Copy to .env. Docker Compose and the Makefile read it.

# PostgreSQL (local development only)
POSTGRES_USER=act
POSTGRES_PASSWORD=act_dev_password
POSTGRES_DB=act

# Backend
ACT_DATABASE_URL=postgresql+psycopg://act:act_dev_password@localhost:5432/act
ACT_LOG_FORMAT=console
ACT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to true when the dashboard is served over HTTPS.
ACT_SESSION_COOKIE_SECURE=false

# First operator, created by `make seed`. Leave the password empty to have a
# random one generated and printed once.
ACT_OPERATOR_USERNAME=operator
ACT_OPERATOR_PASSWORD=

# Dashboard: where the Next.js server reaches the backend
ACT_BACKEND_URL=http://localhost:8000
